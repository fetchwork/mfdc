# MFDC service logs (/var/log/mfdc/*.log from systemd StandardOutput=append).
# Pattern is *.log on purpose: /var/log/mfdc/* would re-rotate dateext archives.
# copytruncate — процессы держат fd; rename без truncate оставил бы запись в старый inode.
# su обязателен: каталог логов freeswitch:freeswitch; без su logrotate на Debian
# пропускает файлы ("parent directory has insecure permissions").
# create не нужен: copytruncate оставляет тот же inode.
/var/log/mfdc/*.log {
	daily
	rotate 10
	missingok
	notifempty
	compress
	delaycompress
	copytruncate
	dateext
	dateformat -%Y%m%d
	su freeswitch freeswitch
}
