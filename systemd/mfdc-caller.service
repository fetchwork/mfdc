[Unit]
Description=MFDC Caller (outbound campaigns)
After=network-online.target postgresql.service rabbitmq-server.service mfdc-runner.service
Wants=network-online.target mfdc-runner.service

[Service]
Type=simple
User=freeswitch
Group=freeswitch
WorkingDirectory=/opt/mfdc
ExecStart=/opt/mfdc/mfdc-caller
Environment=MFDC_SETTINGS=/opt/mfdc/settings.conf
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

StandardOutput=append:/var/log/mfdc/caller.log
StandardError=append:/var/log/mfdc/caller.log

[Install]
WantedBy=multi-user.target
