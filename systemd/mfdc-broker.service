[Unit]
Description=MFDC Broker (dialplan XML, RabbitMQ)
After=network-online.target postgresql.service rabbitmq-server.service mfdc-runner.service
Wants=network-online.target mfdc-runner.service

[Service]
Type=simple
User=freeswitch
Group=freeswitch
WorkingDirectory=/opt/mfdc
ExecStart=/opt/mfdc/mfdc-broker
Environment=MFDC_SETTINGS=/opt/mfdc/settings.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

StandardOutput=append:/var/log/mfdc/broker.log
StandardError=append:/var/log/mfdc/broker.log

[Install]
WantedBy=multi-user.target
